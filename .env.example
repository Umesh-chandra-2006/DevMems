# .env.example - Environment template for DevMem-Agents LLM Router
# Copy this file to .env and populate with your actual free-tier API keys.
# Do NOT commit .env to version control.

# Groq API Keys (Console: https://console.groq.com/keys)
GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=

# Google Gemini API Keys (Google AI Studio: https://aistudio.google.com/)
GEMINI_KEY_1=
GEMINI_KEY_2=

# NVIDIA NIM API Keys (NVIDIA Build: https://build.nvidia.com/)
NIM_KEY_1=
